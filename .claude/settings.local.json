      "Bash(npm view:*)",
      "Bash(npm run sync:*)",
      "Bash(find:*)",
      "Bash(rm:*)",
      "Bash(true)",
      "Bash(grep:*)",
      "Bash(echo:*)",
      "Bash(git add:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(npm version:*)",
      "Bash(npm link:*)",
      "Bash(claude-code-templates:*)",
      "Bash(python:*)",
      "Bash(npm run build:*)",
      "WebFetch(domain:docs.claude.com)",
      "WebSearch",
      "WebFetch(domain:neon.com)",
      "Bash(gh pr create:*)",
      "Bash(mv:*)",
      "Read(//private/tmp/anthropic-skills/**)",
      "Bash(sed:*)",
      "Bash(xargs:*)",
      "Bash(git checkout:*)",
      "Bash(gh pr view:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -r -f /)",
      "Bash(rm -rf ~)",
      "Bash(dd if=*)",
      "Bash(mkfs.*)",
      "Bash(find / -delete*)",
      "Bash(*| base64 -d | bash*)",
      "Bash(*| base64 --decode | bash*)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(chmod 777*)",
      "Bash(curl *| bash*)",
      "Bash(wget *| bash*)",
      "Bash(*> /dev/sda*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push origin +*)",
      "Bash(eval *)",
      "Bash(sudo rm -rf *)",
      "Bash(sudo dd *)",
      "Bash(sudo mkfs*)",
      "Bash(sudo chmod 777*)",
      "Bash(sudo dropdb*)",
